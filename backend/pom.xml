    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>InSilico</groupId>
    <artifactId>janus-backend</artifactId>
    <version>1.0.0-SNAPSHOT</version>

    <name>Janus Backend</name>
    <description>REST API exposing the Janus QSAR assessment workflows</description>

    <properties>
        <java.version>21</java.version>
        <springdoc.version>3.2.0</springdoc.version>
        <therapi.version>0.15.0</therapi.version>
        <!-- where the generated contract is written, for the frontend client generator -->
        <openapi.output.file>${project.basedir}/../api/openapi.json</openapi.output.file>
    </properties>

    <repositories>
        <repository>
            <id>maven-central</id>
            <url>https://repo1.maven.org/maven2/</url>
        </repository>
        <repository>
            <!-- public repo hosted by ProtoQSAR, access with maven-public:maven-public -->
            <id>protoqsar-maven-public</id>
            <url>https://nexus.protoqsar.com/repository/maven-public/</url>
        </repository>
    </repositories>

    <!--
        Two JAXB namespaces have to coexist. The VEGA models read their PMML through jpmml
        1.5.6, which is built against JAXB 2.x and its javax.xml.bind namespace; springdoc needs
        the jakarta.xml.bind annotations of JAXB 4.x, which Spring Boot manages. So the
        jakarta.xml.bind API is left at the version Boot picks, while the JAXB runtime is pinned
        to 2.3.1, the last release that implements the javax namespace. Without this the engine
        fails to start with NoClassDefFoundError: javax/xml/bind/JAXBContext, and with the wrong
        half of it /v3/api-docs fails with NoClassDefFoundError:
        jakarta/xml/bind/annotation/XmlElement. Remove it only together with an upgrade of
        InSilico:Core-Aux past jpmml 1.5.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.glassfish.jaxb</groupId>
                <artifactId>jaxb-runtime</artifactId>
                <version>2.3.1</version>
            </dependency>
            <dependency>
                <groupId>org.glassfish.jaxb</groupId>
                <artifactId>txw2</artifactId>
                <version>2.3.1</version>
            </dependency>
            <dependency>
                <groupId>com.sun.istack</groupId>
                <artifactId>istack-commons-runtime</artifactId>
                <version>3.0.7</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- the javax.xml.bind namespace required by jpmml, see the note above -->
        <dependency>
            <groupId>javax.xml.bind</groupId>
            <artifactId>jaxb-api</artifactId>
            <version>2.3.1</version>
        </dependency>

        <dependency>
            <groupId>org.glassfish.jaxb</groupId>
            <artifactId>jaxb-runtime</artifactId>
        </dependency>

        <!-- OpenAPI contract: served at /v3/api-docs, browsable at /swagger-ui.html -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!--
            Makes springdoc read the Javadoc of the controllers and of the DTOs, so that the
            descriptions of the contract are the ones written in the code and never drift from
            it. It needs the scribe annotation processor configured below.
        -->
        <dependency>
            <groupId>com.github.therapi</groupId>
            <artifactId>therapi-runtime-javadoc</artifactId>
            <version>${therapi.version}</version>
        </dependency>


